            $value = Helpers::extractString($arg);
            if (ErrorValue::isError($value)) {
                // TODO: fix here
                $returnValue = $value;

                // TODO: fix here
                break;
            }
            if ($ignoreEmpty === true && is_string($arg) && trim($arg) === '') {
