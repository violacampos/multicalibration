// Program to fix:
    protected function ensureCacheDirectoryExists($path)
    {
        $directory = dirname($path);

        if (! $this->files->exists($directory)) {
            $this->files->makeDirectory($directory, 0777, true, true);
            $this->ensurePermissionsAreCorrect($directory);
        }
    }