            || ($token->equals('(') &&!$tokens[$tokens->getPrevMeaningfulToken($index)]->isGivenKind(T_ARRAY))
            || isset($alternativeBlockStarts[$index])
            || isset($caseBlockStarts[$index])
        ) {
            if ($token->isGivenKind([T_EXTENDS, T_IMPLEMENTS])) {
